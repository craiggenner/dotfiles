Include /Users/craig.genner/.colima/ssh_config

#Include /Users/craig.genner/.colima/ssh_config

Host *
        GSSAPIAuthentication no
#       ControlMaster auto
#       ControlPath ~/.ssh/connections/%r_%h_%p
        ServerAliveInterval 10
	ConnectTimeout 120
	VerifyHostKeyDNS yes

Host smitty 192.168.1.2
	User craig
        Port 53
#        SecurityKeyProvider /Users/craig.genner/.homebrew/Cellar/libfido2/1.16.0_1dd/lib/libfido2.dylib
	PasswordAuthentication no
        WarnWeakCrypto no-pq-kex

Host hass
	User hass

Host tuxx.org.uk
	User craig
	Port 1233

Host github.com gitlab.*
	ForwardAgent no
	ForwardX11 no
	ForwardX11Trusted no
	RequestTTY no

Host github-priv
        HostName github.com
        IdentityFile ~/.ssh/id_ed25519_priv
	ForwardAgent no
	ForwardX11 no
	ForwardX11Trusted no
	RequestTTY no

Host ec2*
	IdentityFile ~/.ssh/keys/aws.id_rsa
	StrictHostKeyChecking no
	IdentitiesOnly yes
	User ec2-user
	UserKnownHostsFile /dev/null

host i-* mi-*
	ProxyCommand sh -c "aws ssm start-session --target %h --document-name AWS-StartSSHSession --parameters 'portNumber=%p'"

Host *+*
	ProxyCommand ssh $(echo %h | sed 's/+[^+]*$//;s/\([^+%%]*\)%%\([^+]*\)$/\2 -l \1/;s/:/ -p /') nc $(echo %h | sed 's/^.*+//;/:/!s/$/ %p/;s/:/ /')

Host 127.0.0.1
	StrictHostKeyChecking no
	IdentitiesOnly yes
	UserKnownHostsFile /dev/null
